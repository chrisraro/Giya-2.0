# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Service worker build output. @serwist/next compiles src/app/sw.ts into
# public/ on every `next build`; the file embeds the precache manifest and the
# build id, so a committed copy would be stale the moment anything else changes
# and would be served in preference to nothing at all if a build ever skipped
# the step. The SOURCE is src/app/sw.ts.
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# scratch / planning docs (not part of the shipped app)
.superpowers/

# Agent worktrees (created by the SDD loop; live git checkouts, never content)
.claude/worktrees/
